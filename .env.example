# Copy to .env and fill in the credentials from developer-dashboard.whoop.com.
# .env is gitignored — never commit real credentials.
WHOOP_CLIENT_ID=your-client-id
WHOOP_CLIENT_SECRET=your-client-secret

# Must match a redirect URL registered on the WHOOP app, byte for byte.
WHOOP_REDIRECT_URI=http://localhost:8788/callback

# debug | info | warn | error | silent (stderr only)
WHOOP_LOG_LEVEL=info
